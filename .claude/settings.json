{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci --ignore-scripts)",
      "Bash(npm run build)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm test -- *)",
      "Bash(node --test *)",
      "Bash(npm run render)",
      "Bash(npm run render *)",
      "Bash(npm run package)",
      "Bash(npm run e2e)",
      "Bash(npm run e2e:docker)",
      "Bash(npm run icons)",
      "Bash(make check)",
      "Bash(make install)",
      "Bash(code --install-extension diffguide-*.vsix --force)",
      "Bash(code --list-extensions *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh pr list *)",
      "Bash(gh run list *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck-on-stop.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
