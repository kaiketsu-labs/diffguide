      "diffguide-bookmark-filled": {
        "description": "DiffGuide bookmark filled",
        "default": {
          "fontPath": "./resources/diffguide-icons-df9db5b4.woff",
          "fontCharacter": "\\E009"
        }
      },
      "diffguide-search": {
        "description": "DiffGuide search",
        "default": {
          "fontPath": "./resources/diffguide-icons-df9db5b4.woff",
          "fontCharacter": "\\E00A"
        }
      },
      "diffguide-filter": {
        "description": "DiffGuide filter",
