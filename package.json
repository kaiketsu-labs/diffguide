{
  "name": "diffguide",
  "displayName": "DiffGuide",
  "description": "Review local changes and GitHub pull requests with Claude Code on one review page, with automatic feedback delivery.",
  "version": "0.7.0",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#101B29",
    "theme": "dark"
  },
  "publisher": "kaiketsu-labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaiketsu-labs/diffguide.git"
  },
  "homepage": "https://github.com/kaiketsu-labs/diffguide#readme",
  "bugs": {
    "url": "https://github.com/kaiketsu-labs/diffguide/issues"
  },
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=20"
  },
  "categories": [
    "SCM Providers",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "code review",
    "comments",
    "pull request",
    "ai",
    "inline review",
    "git",
    "diff",
    "peer review"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onView:diffGuide.pullRequests",
    "onFileSystem:diffguide-pr",
    "onView:diffGuide.local"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "DiffGuide connects to a coding agent that can edit workspace files."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "icons": "node scripts/icons.mjs",
    "vscode:prepublish": "npm run build",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node scripts/test.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "highlight.js": "11.12.0",
    "jsonc-parser": "3.3.1",
    "markdown-it": "15.0.3",
    "parse5": "8.0.1",
    "pdfjs-dist": "4.10.38",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "contributes": {
    "colors": [
      {
        "id": "diffGuide.selectionBackground",
        "description": "Background of the pinned code selection for the active review comment.",
        "defaults": {
          "dark": "#FFFFFF1A",
          "light": "#0000000F",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "diffGuide.selectionBorder",
        "description": "Border of the pinned code selection for the active review comment.",
        "defaults": {
          "dark": "#FFFFFF66",
          "light": "#00000059",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "diffGuide.inlineCodeForeground",
        "description": "Text color of inline code in comments, replies and PR descriptions.",
        "defaults": {
          "dark": "terminal.ansiCyan",
          "light": "terminal.ansiCyan",
          "highContrast": "terminal.ansiCyan",
          "highContrastLight": "terminal.ansiCyan"
        }
      }
    ],
    "commands": [
      {
        "command": "diffGuide.startClaude",
        "title": "Connect Claude",
        "category": "DiffGuide",
        "icon": "$(plug)"
      },
      {
        "command": "diffGuide.copyClaudeCommand",
        "title": "Copy connect command",
        "category": "DiffGuide",
        "icon": "$(terminal)"
      },
      {
        "command": "diffGuide.connectRunningClaude",
        "title": "Connect running Claude",
        "category": "DiffGuide",
        "icon": "$(plug)"
      },
      {
        "command": "diffGuide.refreshPullRequests",
        "title": "Refresh pull requests",
        "category": "DiffGuide",
        "icon": "$(diffguide-refresh)"
      },
      {
        "command": "diffGuide.searchPullRequests",
        "title": "Search pull requests",
        "category": "DiffGuide",
        "icon": "$(diffguide-search)"
      },
      {
        "command": "diffGuide.openPullRequestLink",
        "title": "Open PR in DiffGuide",
        "category": "DiffGuide",
        "icon": "$(link)"
      },
      {
        "command": "diffGuide.copyPullRequestLink",
        "title": "Copy Link",
        "category": "DiffGuide",
        "icon": "$(copy)"
      },
      {
        "command": "diffGuide.showAwaitingReviewOnly",
        "title": "Show only my PRs awaiting review",
        "category": "DiffGuide",
        "icon": "$(eye)"
      },
      {
        "command": "diffGuide.showAllMine",
        "title": "Show all my PRs",
        "category": "DiffGuide",
        "icon": "$(eye-closed)"
      },
      {
        "command": "diffGuide.cleanUpWorktrees",
        "title": "Clean up worktrees",
        "category": "DiffGuide",
        "icon": "$(trash)"
      },
      {
        "command": "diffGuide.signInToGitHub",
        "title": "Sign in to GitHub",
        "category": "DiffGuide",
        "icon": "$(account)"
      },
      {
        "command": "diffGuide.filterByAuthor",
        "title": "Filter by author",
        "category": "DiffGuide",
        "icon": "$(diffguide-filter)"
      },
      {
        "command": "diffGuide.filterByAuthorActive",
        "title": "Filter by author",
        "category": "DiffGuide",
        "icon": "$(diffguide-filter-active)"
      },
      {
        "command": "diffGuide.groupByRole",
        "title": "Group by role",
        "category": "DiffGuide"
      },
      {
        "command": "diffGuide.groupByRepository",
        "title": "Group by repository",
        "category": "DiffGuide"
      },
      {
        "command": "diffGuide.chooseRepositories",
        "title": "Choose repositories...",
        "category": "DiffGuide",
        "icon": "$(filter)"
      },
      {
        "command": "diffGuide.hideRepository",
        "title": "Hide repository",
        "category": "DiffGuide",
        "icon": "$(eye-closed)"
      },
      {
        "command": "diffGuide.openPullRequestInBrowser",
        "title": "Open in browser",
        "category": "DiffGuide",
        "icon": "$(link-external)"
      },
      {
        "command": "diffGuide.openPullRequest",
        "title": "Open review page",
        "category": "DiffGuide",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "diffGuide.pinPullRequest",
        "title": "Bookmark",
        "category": "DiffGuide",
        "icon": "$(diffguide-bookmark)"
      },
      {
        "command": "diffGuide.unpinPullRequest",
        "title": "Remove bookmark",
        "category": "DiffGuide",
        "icon": "$(diffguide-bookmark-filled)"
      },
      {
        "command": "diffGuide.removePullRequestWorktree",
        "title": "Remove worktree",
        "category": "DiffGuide",
        "icon": "$(trash)"
      },
      {
        "command": "diffGuide.showPullRequestClaude",
        "title": "Show Claude activity",
        "category": "DiffGuide",
        "icon": "$(diffguide-orb)"
      },
      {
        "command": "diffGuide.showPullRequestOverview",
        "title": "Open review page",
        "category": "DiffGuide",
        "icon": "$(diffguide-mark)"
      },
      {
        "command": "diffGuide.openLocalReview",
        "title": "Review local changes",
        "category": "DiffGuide",
        "icon": "$(git-compare)"
      },
      {
        "command": "diffGuide.showOnReviewPage",
        "title": "Show in DiffGuide",
        "category": "DiffGuide"
      },
      {
        "command": "diffGuide.refreshLocalFiles",
        "title": "Refresh files",
        "category": "DiffGuide",
        "icon": "$(diffguide-refresh)"
      },
      {
        "command": "diffGuide.filterLocal",
        "title": "Filter checkouts",
        "category": "DiffGuide",
        "icon": "$(diffguide-filter)"
      },
      {
        "command": "diffGuide.filterLocalActive",
        "title": "Filter checkouts",
        "category": "DiffGuide",
        "icon": "$(diffguide-filter-active)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "diffGuide",
          "title": "DiffGuide",
          "icon": "resources/review.svg"
        }
      ]
    },
    "views": {
      "diffGuide": [
        {
          "id": "diffGuide.pullRequests",
          "name": "Pull Requests",
          "icon": "resources/review.svg"
        },
        {
          "id": "diffGuide.local",
          "name": "Local",
          "icon": "resources/review.svg"
        },
        {
          "id": "diffGuide.answers",
          "name": "Claude Answers",
          "icon": "resources/review.svg"
        },
        {
          "id": "diffGuide.legend",
          "name": "Legend",
          "icon": "resources/review.svg",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "diffGuide.local",
        "contents": "Open a Git repository to review its local changes with Claude.",
        "when": "!diffGuide.localAvailable"
      },
      {
        "view": "diffGuide.answers",
        "contents": "Claude's latest answers on your PRs show up here, newest first. New ones stay marked until you see them on the review page."
      },
      {
        "view": "diffGuide.pullRequests",
        "contents": "Sign in to GitHub to see your pull requests.\n[Sign in to GitHub](command:diffGuide.signInToGitHub)",
        "when": "diffGuide.gitHubSignIn == github"
      },
      {
        "view": "diffGuide.pullRequests",
        "contents": "Sign in to your GitHub Enterprise host to see your pull requests.\n[Sign in to GitHub Enterprise](command:diffGuide.signInToGitHub)",
        "when": "diffGuide.gitHubSignIn == github-enterprise"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "diffGuide.openLocalReview",
          "when": "view == diffGuide.local && diffGuide.localSingle",
          "group": "navigation@1"
        },
        {
          "command": "diffGuide.filterLocal",
          "when": "view == diffGuide.local && diffGuide.localAvailable && !diffGuide.localFiltered",
          "group": "navigation@2.5"
        },
        {
          "command": "diffGuide.filterLocalActive",
          "when": "view == diffGuide.local && diffGuide.localFiltered",
          "group": "navigation@2.5"
        },
        {
          "command": "diffGuide.refreshLocalFiles",
          "when": "view == diffGuide.local && diffGuide.localAvailable",
          "group": "navigation@3"
        },
        {
          "command": "diffGuide.searchPullRequests",
          "when": "view == diffGuide.pullRequests",
          "group": "navigation@-1"
        },
        {
          "command": "diffGuide.refreshPullRequests",
          "when": "view == diffGuide.pullRequests",
          "group": "navigation@1"
        },
        {
          "command": "diffGuide.filterByAuthor",
          "when": "view == diffGuide.pullRequests && !diffGuide.authorFiltered",
          "group": "navigation@0"
        },
        {
          "command": "diffGuide.filterByAuthorActive",
          "when": "view == diffGuide.pullRequests && diffGuide.authorFiltered",
          "group": "navigation@0"
        },
        {
          "command": "diffGuide.chooseRepositories",
          "when": "view == diffGuide.pullRequests",
          "group": "1_repositories@1"
        },
        {
          "command": "diffGuide.groupByRepository",
          "when": "view == diffGuide.pullRequests && diffGuide.groupByRole",
          "group": "2_grouping@1"
        },
        {
          "command": "diffGuide.groupByRole",
          "when": "view == diffGuide.pullRequests && !diffGuide.groupByRole",
          "group": "2_grouping@1"
        },
        {
          "command": "diffGuide.showAwaitingReviewOnly",
          "when": "view == diffGuide.pullRequests && !diffGuide.awaitingReviewOnly",
          "group": "3_filter@1"
        },
        {
          "command": "diffGuide.showAllMine",
          "when": "view == diffGuide.pullRequests && diffGuide.awaitingReviewOnly",
          "group": "3_filter@1"
        },
        {
          "command": "diffGuide.openPullRequestLink",
          "when": "view == diffGuide.pullRequests",
          "group": "0_open@1"
        }
      ],
      "view/item/context": [
        {
          "command": "diffGuide.openLocalReview",
          "when": "view == diffGuide.local && viewItem == diffGuide.checkout",
          "group": "inline"
        },
        {
          "command": "diffGuide.pinPullRequest",
          "when": "view == diffGuide.pullRequests && viewItem =~ /^diffGuide\\.pullRequest(\\.checkedOut)?$/",
          "group": "inline@0"
        },
        {
          "command": "diffGuide.unpinPullRequest",
          "when": "view == diffGuide.pullRequests && viewItem =~ /^diffGuide\\.pullRequest.*\\.pinned$/",
          "group": "inline@0"
        },
        {
          "command": "diffGuide.hideRepository",
          "when": "view == diffGuide.pullRequests && viewItem == diffGuide.repository",
          "group": "1_repository@1"
        },
        {
          "command": "diffGuide.openPullRequestInBrowser",
          "when": "view == diffGuide.pullRequests && viewItem =~ /^diffGuide\\.pullRequest/",
          "group": "1_pullRequest@2"
        },
        {
          "command": "diffGuide.copyPullRequestLink",
          "when": "view == diffGuide.pullRequests && viewItem =~ /^diffGuide\\.pullRequest/",
          "group": "1_pullRequest@3"
        },
        {
          "command": "diffGuide.showPullRequestClaude",
          "when": "view == diffGuide.pullRequests && viewItem =~ /^diffGuide\\.pullRequest\\.checkedOut/",
          "group": "1_pullRequest@1"
        },
        {
          "command": "diffGuide.removePullRequestWorktree",
          "when": "view == diffGuide.pullRequests && viewItem =~ /^diffGuide\\.pullRequest\\.checkedOut/",
          "group": "2_worktree@0"
        },
        {
          "command": "diffGuide.showPullRequestOverview",
          "when": "view == diffGuide.pullRequests && viewItem =~ /^diffGuide\\.pullRequest\\.checkedOut/",
          "group": "1_pullRequest@0"
        }
      ],
      "commandPalette": [
        {
          "command": "diffGuide.pinPullRequest",
          "when": "false"
        },
        {
          "command": "diffGuide.unpinPullRequest",
          "when": "false"
        },
        {
          "command": "diffGuide.filterByAuthorActive",
          "when": "false"
        },
        {
          "command": "diffGuide.openPullRequestInBrowser",
          "when": "false"
        },
        {
          "command": "diffGuide.openPullRequest",
          "when": "false"
        },
        {
          "command": "diffGuide.removePullRequestWorktree",
          "when": "false"
        },
        {
          "command": "diffGuide.showPullRequestClaude",
          "when": "false"
        },
        {
          "command": "diffGuide.showPullRequestOverview",
          "when": "false"
        },
        {
          "command": "diffGuide.hideRepository",
          "when": "false"
        },
        {
          "command": "diffGuide.copyPullRequestLink",
          "when": "false"
        },
        {
          "command": "diffGuide.filterLocalActive",
          "when": "false"
        },
        {
          "command": "diffGuide.showOnReviewPage",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "diffGuide.showOnReviewPage",
          "when": "diffGuide.localAvailable && !explorerResourceIsFolder",
          "group": "navigation@20"
        }
      ]
    },
    "configuration": {
      "title": "DiffGuide",
      "properties": {
        "diffGuide.claudePath": {
          "type": "string",
          "default": "claude",
          "scope": "machine-overridable",
          "description": "Path to the Claude Code executable. Trusted projects can override it."
        },
        "diffGuide.nodePath": {
          "type": "string",
          "default": "node",
          "scope": "machine-overridable",
          "description": "Path to Node.js 20 or newer. Trusted projects can override it."
        },
        "diffGuide.transport": {
          "type": "string",
          "enum": [
            "hooks",
            "channels"
          ],
          "default": "hooks",
          "description": "Background delivery (default: hooks). channels is an experimental alternative with extra requirements."
        },
        "diffGuide.worktreeCleanupDays": {
          "type": "number",
          "default": 14,
          "minimum": 0,
          "description": "Remove a PR worktree that was not opened for this many days. Worktrees of merged or closed PRs are removed regardless. Worktrees with uncommitted changes or unpushed commits are always kept. 0 removes only merged or closed ones."
        },
        "diffGuide.mockPullRequests": {
          "type": "boolean",
          "default": false,
          "description": "Show sample pull requests instead of querying GitHub. For development and testing only."
        }
      }
    },
    "icons": {
      "diffguide-orb": {
        "description": "DiffGuide orb",
        "default": {
          "fontPath": "./resources/diffguide-icons-df9db5b4.woff",
          "fontCharacter": "\\E000"
