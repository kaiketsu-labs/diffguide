        "default": {
          "fontPath": "./resources/diffguide-icons-df9db5b4.woff",
          "fontCharacter": "\\E001"
        }
      },
      "diffguide-orb-away": {
        "description": "DiffGuide orb away",
        "default": {
          "fontPath": "./resources/diffguide-icons-df9db5b4.woff",
          "fontCharacter": "\\E002"
        }
      },
