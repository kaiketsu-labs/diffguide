          "fontCharacter": "\\E013"
        }
      },
      "diffguide-comment": {
        "description": "DiffGuide comment",
        "default": {
          "fontPath": "./resources/diffguide-icons-df9db5b4.woff",
          "fontCharacter": "\\E014"
        }
      },
      "diffguide-show": {
        "description": "DiffGuide show",
        "default": {
          "fontPath": "./resources/diffguide-icons-df9db5b4.woff",
          "fontCharacter": "\\E015"
        }
      }
    }
  }
}
