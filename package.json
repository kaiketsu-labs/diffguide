{
  "name": "diffguide",
  "displayName": "DiffGuide",
  "description": "An AI-powered code review companion that helps you explore changes, ask questions and improve code while keeping you in control.",
  "version": "0.5.1",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#101B29",
    "theme": "dark"
  },
  "publisher": "kaiketsu-labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaiketsu-labs/diffguide.git"
  },
  "homepage": "https://github.com/kaiketsu-labs/diffguide#readme",
  "bugs": {
    "url": "https://github.com/kaiketsu-labs/diffguide/issues"
  },
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=20"
  },
  "categories": [
    "SCM Providers",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "code review",
    "comments",
    "pull request",
    "ai",
    "inline review",
    "git",
    "diff",
    "peer review"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onView:diffGuide.pullRequests",
    "onFileSystem:diffguide-pr"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "DiffGuide connects to a coding agent that can edit workspace files."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "icons": "node scripts/icons.mjs",
    "vscode:prepublish": "npm run build",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node scripts/test.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "highlight.js": "11.12.0",
    "jsonc-parser": "3.3.1",
    "markdown-it": "15.0.3",
    "parse5": "8.0.1",
    "pdfjs-dist": "4.10.38",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "contributes": {
    "colors": [
      {
        "id": "diffGuide.selectionBackground",
        "description": "Hintergrund der fixierten Codeauswahl für den aktiven Review-Kommentar.",
        "defaults": {
          "dark": "#FFFFFF1A",
          "light": "#0000000F",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "diffGuide.selectionBorder",
        "description": "Rahmen der fixierten Codeauswahl für den aktiven Review-Kommentar.",
        "defaults": {
          "dark": "#FFFFFF66",
          "light": "#00000059",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      }
    ],
    "commands": [
      {
        "command": "diffGuide.startClaude",
        "title": "Mit Claude verbinden",
        "category": "DiffGuide",
        "icon": "$(plug)"
      },
      {
        "command": "diffGuide.copyClaudeCommand",
        "title": "Verbindungsbefehl kopieren",
        "category": "DiffGuide",
        "icon": "$(terminal)"
      },
      {
        "command": "diffGuide.connectRunningClaude",
        "title": "Laufende Unterhaltung verbinden",
        "category": "DiffGuide",
        "icon": "$(plug)"
      },
      {
        "command": "diffGuide.addComment",
        "title": "Kommentar hinzufügen",
        "category": "DiffGuide",
        "icon": "$(comment-add)"
      },
      {
        "command": "diffGuide.openComposer",
        "title": "Feedback in Seitenansicht schreiben",
        "category": "DiffGuide",
        "icon": "$(open-preview)"
      },
      {
        "command": "diffGuide.openCode",
        "title": "Code im Editor öffnen",
        "category": "DiffGuide",
        "icon": "$(go-to-file)"
      },
      {
        "command": "diffGuide.openCommentCode",
        "title": "Code im Editor öffnen",
        "category": "DiffGuide",
        "icon": "$(go-to-file)"
      },
      {
        "command": "diffGuide.submitInline",
        "title": "Senden",
        "category": "DiffGuide",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "diffGuide.cancelDraft",
        "title": "Entwurf verwerfen",
        "category": "DiffGuide",
        "icon": "$(close)"
      },
      {
        "command": "diffGuide.openChanges",
        "title": "Änderungen reviewen",
        "category": "DiffGuide",
        "icon": "$(git-compare)"
      },
      {
        "command": "diffGuide.revealThread",
        "title": "Zum Kommentar springen",
        "category": "DiffGuide"
      },
      {
        "command": "diffGuide.composeReply",
        "title": "In Seitenansicht antworten",
        "category": "DiffGuide",
        "icon": "$(open-preview)"
      },
      {
        "command": "diffGuide.resumeDraft",
        "title": "Entwurf fortsetzen",
        "category": "DiffGuide",
        "icon": "$(edit)"
      },
      {
        "command": "diffGuide.exportToPr",
        "title": "An GitHub-PR übergeben",
        "category": "DiffGuide",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "diffGuide.resolve",
        "title": "Als erledigt markieren",
        "category": "DiffGuide",
        "icon": "$(check)"
      },
      {
        "command": "diffGuide.showResolved",
        "title": "Erledigte anzeigen",
        "category": "DiffGuide",
        "icon": "$(eye)"
      },
      {
        "command": "diffGuide.hideResolved",
        "title": "Erledigte ausblenden",
        "category": "DiffGuide",
        "icon": "$(eye-closed)"
      },
      {
        "command": "diffGuide.enhanceContrast",
        "title": "Kommentarfenster hervorheben",
        "category": "DiffGuide",
        "icon": "$(color-mode)"
      },
      {
        "command": "diffGuide.toggleCenteredLayout",
        "title": "Zentrierte Ansicht",
        "category": "DiffGuide",
        "icon": "$(layout-centered)"
      },
      {
        "command": "diffGuide.resetContrast",
        "title": "Standarddarstellung wiederherstellen",
        "category": "DiffGuide",
        "icon": "$(discard)"
      },
      {
        "command": "diffGuide.reopen",
        "title": "Wieder öffnen",
        "category": "DiffGuide",
        "icon": "$(debug-restart)"
      },
      {
        "command": "diffGuide.refreshPullRequests",
        "title": "Refresh pull requests",
        "category": "DiffGuide",
        "icon": "$(diffguide-refresh)"
      },
      {
        "command": "diffGuide.searchPullRequests",
        "title": "Search pull requests",
        "category": "DiffGuide",
        "icon": "$(diffguide-search)"
      },
      {
        "command": "diffGuide.openPullRequestLink",
        "title": "Open PR in DiffGuide",
        "category": "DiffGuide",
        "icon": "$(link)"
      },
      {
        "command": "diffGuide.copyPullRequestLink",
        "title": "Copy Link",
        "category": "DiffGuide",
        "icon": "$(copy)"
      },
      {
        "command": "diffGuide.showAwaitingReviewOnly",
        "title": "Show only my PRs awaiting review",
        "category": "DiffGuide",
        "icon": "$(eye)"
      },
      {
        "command": "diffGuide.showAllMine",
        "title": "Show all my PRs",
        "category": "DiffGuide",
        "icon": "$(eye-closed)"
      },
      {
        "command": "diffGuide.cleanUpWorktrees",
        "title": "Clean up worktrees",
        "category": "DiffGuide",
        "icon": "$(trash)"
      },
      {
        "command": "diffGuide.signInToGitHub",
        "title": "Sign in to GitHub",
        "category": "DiffGuide",
        "icon": "$(account)"
      },
      {
        "command": "diffGuide.filterByAuthor",
        "title": "Filter by author",
        "category": "DiffGuide",
        "icon": "$(diffguide-filter)"
      },
      {
        "command": "diffGuide.filterByAuthorActive",
        "title": "Filter by author",
        "category": "DiffGuide",
        "icon": "$(diffguide-filter-active)"
      },
      {
        "command": "diffGuide.groupByRole",
        "title": "Group by role",
        "category": "DiffGuide"
      },
      {
        "command": "diffGuide.groupByRepository",
        "title": "Group by repository",
        "category": "DiffGuide"
      },
      {
        "command": "diffGuide.chooseRepositories",
        "title": "Choose repositories...",
        "category": "DiffGuide",
        "icon": "$(filter)"
      },
      {
        "command": "diffGuide.hideRepository",
        "title": "Hide repository",
        "category": "DiffGuide",
        "icon": "$(eye-closed)"
      },
      {
        "command": "diffGuide.openPullRequestInBrowser",
        "title": "Open in browser",
        "category": "DiffGuide",
        "icon": "$(link-external)"
      },
      {
        "command": "diffGuide.openPullRequest",
        "title": "Open review page",
        "category": "DiffGuide",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "diffGuide.pinPullRequest",
        "title": "Bookmark",
        "category": "DiffGuide",
        "icon": "$(diffguide-bookmark)"
      },
      {
        "command": "diffGuide.unpinPullRequest",
        "title": "Remove bookmark",
        "category": "DiffGuide",
        "icon": "$(diffguide-bookmark-filled)"
      },
      {
        "command": "diffGuide.removePullRequestWorktree",
        "title": "Remove worktree",
        "category": "DiffGuide",
        "icon": "$(trash)"
      },
      {
        "command": "diffGuide.showPullRequestClaude",
        "title": "Show Claude activity",
        "category": "DiffGuide",
        "icon": "$(diffguide-orb)"
      },
      {
        "command": "diffGuide.showPullRequestOverview",
        "title": "Open review page",
        "category": "DiffGuide",
        "icon": "$(diffguide-mark)"
      },
      {
        "command": "diffGuide.publishThread",
        "title": "Publish to GitHub",
        "category": "DiffGuide",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "diffGuide.openPublishedThread",
        "title": "Open on GitHub",
        "category": "DiffGuide",
        "icon": "$(github)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "diffGuide",
          "title": "DiffGuide",
          "icon": "resources/review.svg"
        }
      ]
    },
    "views": {
      "diffGuide": [
        {
          "id": "diffGuide.pullRequests",
          "name": "Pull Requests",
          "icon": "resources/review.svg"
        },
        {
          "id": "diffGuide.answers",
          "name": "Claude Answers",
          "icon": "resources/review.svg"
        },
        {
          "id": "diffGuide.threads",
          "name": "Review",
          "icon": "resources/review.svg"
        },
        {
          "id": "diffGuide.legend",
          "name": "Legend",
          "icon": "resources/review.svg",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "diffGuide.threads",
        "contents": "Feedback direkt an Claude Code.\n[Mit Claude verbinden](command:diffGuide.startClaude)\n[Änderungen reviewen](command:diffGuide.openChanges)\nMarkiere Code und füge einen Kommentar hinzu. Abgeschickte Kommentare werden automatisch zugestellt."
      },
      {
        "view": "diffGuide.answers",
        "contents": "Claude's latest answers on your PRs show up here, newest first. New ones stay marked until you see them on the review page."
      },
      {
        "view": "diffGuide.pullRequests",
        "contents": "Sign in to GitHub to see your pull requests.\n[Sign in to GitHub](command:diffGuide.signInToGitHub)",
        "when": "diffGuide.gitHubSignIn == github"
      },
      {
        "view": "diffGuide.pullRequests",
        "contents": "Sign in to your GitHub Enterprise host to see your pull requests.\n[Sign in to GitHub Enterprise](command:diffGuide.signInToGitHub)",
        "when": "diffGuide.gitHubSignIn == github-enterprise"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "diffGuide.addComment",
          "when": "(resourceScheme == file || resourceScheme == diffguide-base || resourceScheme == diffguide-pr) && isWorkspaceTrusted",
          "group": "navigation@20"
        }
      ],
      "editor/title": [
        {
          "command": "diffGuide.addComment",
          "when": "(resourceScheme == file || resourceScheme == diffguide-base || resourceScheme == diffguide-pr) && isWorkspaceTrusted",
          "group": "navigation@20"
        }
      ],
      "scm/title": [
        {
          "command": "diffGuide.openChanges",
          "when": "scmProvider == git",
          "group": "navigation@20"
        }
      ],
      "view/title": [
        {
          "command": "diffGuide.searchPullRequests",
          "when": "view == diffGuide.pullRequests",
          "group": "navigation@-1"
        },
        {
          "command": "diffGuide.refreshPullRequests",
          "when": "view == diffGuide.pullRequests",
          "group": "navigation@1"
        },
        {
          "command": "diffGuide.filterByAuthor",
          "when": "view == diffGuide.pullRequests && !diffGuide.authorFiltered",
          "group": "navigation@0"
        },
        {
          "command": "diffGuide.filterByAuthorActive",
          "when": "view == diffGuide.pullRequests && diffGuide.authorFiltered",
          "group": "navigation@0"
        },
        {
          "command": "diffGuide.chooseRepositories",
          "when": "view == diffGuide.pullRequests",
          "group": "1_repositories@1"
        },
        {
          "command": "diffGuide.groupByRepository",
          "when": "view == diffGuide.pullRequests && diffGuide.groupByRole",
          "group": "2_grouping@1"
        },
        {
          "command": "diffGuide.groupByRole",
          "when": "view == diffGuide.pullRequests && !diffGuide.groupByRole",
          "group": "2_grouping@1"
        },
        {
          "command": "diffGuide.showAwaitingReviewOnly",
          "when": "view == diffGuide.pullRequests && !diffGuide.awaitingReviewOnly",
          "group": "3_filter@1"
        },
        {
          "command": "diffGuide.showAllMine",
          "when": "view == diffGuide.pullRequests && diffGuide.awaitingReviewOnly",
          "group": "3_filter@1"
        },
        {
          "command": "diffGuide.openPullRequestLink",
          "when": "view == diffGuide.pullRequests",
          "group": "0_open@1"
        },
        {
          "command": "diffGuide.startClaude",
          "when": "view == diffGuide.threads",
          "group": "navigation@1"
        },
        {
          "command": "diffGuide.copyClaudeCommand",
          "when": "view == diffGuide.threads",
          "group": "connection@1"
        },
        {
          "command": "diffGuide.openChanges",
          "when": "view == diffGuide.threads",
          "group": "navigation@2"
        },
        {
          "command": "diffGuide.exportToPr",
          "when": "view == diffGuide.threads",
          "group": "navigation@3"
        },
        {
          "command": "diffGuide.showResolved",
          "when": "view == diffGuide.threads && !diffGuide.showResolved",
          "group": "navigation@4"
        },
        {
          "command": "diffGuide.hideResolved",
          "when": "view == diffGuide.threads && diffGuide.showResolved",
          "group": "navigation@4"
        },
        {
          "command": "diffGuide.enhanceContrast",
          "when": "view == diffGuide.threads",
          "group": "navigation@5"
        },
        {
          "command": "diffGuide.toggleCenteredLayout",
          "when": "view == diffGuide.threads",
          "group": "appearance@1"
        },
        {
          "command": "diffGuide.resetContrast",
          "when": "view == diffGuide.threads",
          "group": "appearance@2"
        }
      ],
      "view/item/context": [
        {
          "command": "diffGuide.pinPullRequest",
          "when": "view == diffGuide.pullRequests && viewItem =~ /^diffGuide\\.pullRequest(\\.checkedOut)?$/",
          "group": "inline@0"
        },
        {
          "command": "diffGuide.unpinPullRequest",
          "when": "view == diffGuide.pullRequests && viewItem =~ /^diffGuide\\.pullRequest.*\\.pinned$/",
          "group": "inline@0"
        },
        {
          "command": "diffGuide.hideRepository",
          "when": "view == diffGuide.pullRequests && viewItem == diffGuide.repository",
          "group": "1_repository@1"
        },
        {
          "command": "diffGuide.openPullRequestInBrowser",
          "when": "view == diffGuide.pullRequests && viewItem =~ /^diffGuide\\.pullRequest/",
          "group": "1_pullRequest@2"
        },
        {
          "command": "diffGuide.copyPullRequestLink",
          "when": "view == diffGuide.pullRequests && viewItem =~ /^diffGuide\\.pullRequest/",
          "group": "1_pullRequest@3"
        },
        {
          "command": "diffGuide.showPullRequestClaude",
          "when": "view == diffGuide.pullRequests && viewItem =~ /^diffGuide\\.pullRequest\\.checkedOut/",
          "group": "1_pullRequest@1"
        },
        {
          "command": "diffGuide.removePullRequestWorktree",
          "when": "view == diffGuide.pullRequests && viewItem =~ /^diffGuide\\.pullRequest\\.checkedOut/",
          "group": "2_worktree@0"
        },
        {
          "command": "diffGuide.showPullRequestOverview",
          "when": "view == diffGuide.pullRequests && viewItem =~ /^diffGuide\\.pullRequest\\.checkedOut/",
          "group": "1_pullRequest@0"
        },
        {
          "command": "diffGuide.resolve",
          "when": "view == diffGuide.threads && viewItem =~ /^diffGuide\\.open/",
          "group": "inline@1"
        },
        {
          "command": "diffGuide.reopen",
          "when": "view == diffGuide.threads && viewItem =~ /^diffGuide\\.resolved/",
          "group": "inline@1"
        },
        {
          "command": "diffGuide.publishThread",
          "when": "view == diffGuide.threads && viewItem =~ /\\.publishable$/",
          "group": "inline@0"
        },
        {
          "command": "diffGuide.openPublishedThread",
          "when": "view == diffGuide.threads && viewItem =~ /\\.published$/",
          "group": "inline@0"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "diffGuide.submitInline",
          "when": "commentController == diffGuide",
          "group": "inline@1"
        }
      ],
      "comments/comment/title": [
        {
          "command": "diffGuide.openCommentCode",
          "when": "commentController == diffGuide && comment == diffGuide.code",
          "group": "inline@1"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "diffGuide.cancelDraft",
          "when": "commentController == diffGuide && commentThreadIsEmpty",
          "group": "inline@1"
        },
        {
          "command": "diffGuide.composeReply",
          "when": "commentController == diffGuide && commentThread =~ /^diffGuide\\.open/",
          "group": "navigation@1"
        },
        {
          "command": "diffGuide.publishThread",
          "when": "commentController == diffGuide && commentThread =~ /\\.publishable$/",
          "group": "inline@1"
        },
        {
          "command": "diffGuide.openPublishedThread",
          "when": "commentController == diffGuide && commentThread =~ /\\.published$/",
          "group": "inline@1"
        },
        {
          "command": "diffGuide.resolve",
          "when": "commentController == diffGuide && commentThread =~ /^diffGuide\\.open/",
          "group": "inline@2"
        },
        {
          "command": "diffGuide.reopen",
          "when": "commentController == diffGuide && commentThread =~ /^diffGuide\\.resolved/",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "diffGuide.pinPullRequest",
          "when": "false"
        },
        {
          "command": "diffGuide.unpinPullRequest",
          "when": "false"
        },
        {
          "command": "diffGuide.filterByAuthorActive",
          "when": "false"
        },
        {
          "command": "diffGuide.openPullRequestInBrowser",
          "when": "false"
        },
        {
          "command": "diffGuide.openPullRequest",
          "when": "false"
        },
        {
          "command": "diffGuide.removePullRequestWorktree",
          "when": "false"
        },
        {
          "command": "diffGuide.showPullRequestClaude",
          "when": "false"
        },
        {
          "command": "diffGuide.showPullRequestOverview",
          "when": "false"
        },
        {
          "command": "diffGuide.publishThread",
          "when": "false"
        },
        {
          "command": "diffGuide.openPublishedThread",
          "when": "false"
        },
        {
          "command": "diffGuide.openCode",
          "when": "false"
        },
        {
          "command": "diffGuide.openCommentCode",
          "when": "false"
        },
        {
          "command": "diffGuide.submitInline",
          "when": "false"
        },
        {
          "command": "diffGuide.cancelDraft",
          "when": "false"
        },
        {
          "command": "diffGuide.composeReply",
          "when": "false"
        },
        {
          "command": "diffGuide.showResolved",
          "when": "!diffGuide.showResolved"
        },
        {
          "command": "diffGuide.hideResolved",
          "when": "diffGuide.showResolved"
        },
        {
          "command": "diffGuide.resolve",
          "when": "false"
        },
        {
          "command": "diffGuide.reopen",
          "when": "false"
        },
        {
          "command": "diffGuide.revealThread",
          "when": "false"
        },
        {
          "command": "diffGuide.hideRepository",
          "when": "false"
        },
        {
          "command": "diffGuide.copyPullRequestLink",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "diffGuide.addComment",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && (resourceScheme == file || resourceScheme == diffguide-base)"
      }
    ],
    "configuration": {
      "title": "DiffGuide",
      "properties": {
        "diffGuide.claudePath": {
          "type": "string",
          "default": "claude",
          "scope": "machine-overridable",
          "description": "Pfad zur Claude-Code-Anwendung. In vertrauenswürdigen Projekten überschreibbar."
        },
        "diffGuide.nodePath": {
          "type": "string",
          "default": "node",
          "scope": "machine-overridable",
          "description": "Pfad zu Node.js 20 oder neuer. In vertrauenswürdigen Projekten überschreibbar."
        },
        "diffGuide.transport": {
          "type": "string",
          "enum": [
            "hooks",
            "channels"
          ],
          "default": "hooks",
          "description": "Automatische Zustellung im Hintergrund (Standard: hooks). channels ist eine experimentelle Alternative mit zusätzlichen Voraussetzungen."
        },
        "diffGuide.worktreeCleanupDays": {
          "type": "number",
          "default": 14,
          "minimum": 0,
          "description": "Remove a PR worktree that was not opened for this many days. Worktrees of merged or closed PRs are removed regardless. Worktrees with uncommitted changes or unpushed commits are always kept. 0 removes only merged or closed ones."
        },
        "diffGuide.mockPullRequests": {
          "type": "boolean",
          "default": false,
          "description": "Show sample pull requests instead of querying GitHub. For development and testing only."
        }
      }
    },
    "icons": {
      "diffguide-orb": {
        "description": "DiffGuide orb",
        "default": {
          "fontPath": "./resources/diffguide-icons-d643ab6e.woff",
          "fontCharacter": "\\E000"
        }
      },
      "diffguide-orb-asleep": {
        "description": "DiffGuide orb asleep",
        "default": {
          "fontPath": "./resources/diffguide-icons-d643ab6e.woff",
          "fontCharacter": "\\E001"
        }
      },
      "diffguide-orb-away": {
        "description": "DiffGuide orb away",
        "default": {
          "fontPath": "./resources/diffguide-icons-d643ab6e.woff",
          "fontCharacter": "\\E002"
