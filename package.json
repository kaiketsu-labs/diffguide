      },
      "diffguide-stack": {
        "description": "DiffGuide stack",
        "default": {
          "fontPath": "./resources/diffguide-icons-df9db5b4.woff",
          "fontCharacter": "\\E006"
        }
      },
      "diffguide-repository": {
        "description": "DiffGuide repository",
        "default": {
          "fontPath": "./resources/diffguide-icons-df9db5b4.woff",
